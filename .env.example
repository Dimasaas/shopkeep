# Copie para .env e preencha. NUNCA comite o .env.

# --- Aplicação (Discord Developer Portal) ---
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# --- Preenchidos pelo /setup (ele imprime os valores no fim) ---
CATEGORIA_TICKETS_ID=
CANAL_PAINEL_ID=
CANAL_LOGS_ID=
CARGO_EQUIPE_ID=
CARGO_CLIENTE_ID=

# --- Pagamento ---
# Provedores disponíveis: "falso" (desenvolvimento)
PAGAMENTO_PROVEDOR=falso
# Provedor falso: confirma sozinho depois de N segundos (0 = só por comando /confirmar)
PAGAMENTO_FALSO_AUTO_SEGUNDOS=0
